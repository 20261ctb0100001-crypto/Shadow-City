; Engine configuration file.
; Shadow City - Godot 4 starter project

config_version=5

[application]
config/name="Shadow City"
run/main_scene="res://scenes/main.tscn"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="mobile"
textures/default_filters/use_nearest_mipmap_filter=true
textures/default_filters/anisotropic_filtering_level=4
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/positional_shadow/atlas_size=2048

[physics]
3d/default_gravity=9.8

[input]

move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 87)]
}
move_backward={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 83)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 65)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 68)]
}

interact={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 69)]
}
